                 .map_err(|err| anyhow::format_err!("Failed to create renderer: {:?}", err))?
         } else {
             self.api
-                .single_renderer(&self.target_node)
+                .single_renderer(&effective_target)
                 .map_err(|err| anyhow::format_err!("Failed to create renderer: {:?}", err))?
         };
 
