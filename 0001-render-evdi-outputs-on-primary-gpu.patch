@@ -995,26 +1012,39 @@ impl SurfaceThreadState {
             return Ok(());
         };
 
-        let render_node = render_node_for_output(
-            self.mirroring.as_ref().unwrap_or(&self.output),
-            self.primary_node
-                .read()
-                .unwrap()
-                .as_ref()
-                .unwrap_or(&self.target_node),
-            &self.target_node,
-            &self.shell.read(),
-        );
+        // For software targets (evdi/DisplayLink) whose swapchain was moved to the
+        // primary GPU, render there directly to avoid llvmpipe and the cross-device copy.
+        let use_primary =
+            self.target_is_software && self.swapchain_on_primary.load(Ordering::Relaxed);
+        let primary = *self
+            .primary_node
+            .read()
+            .unwrap()
+            .as_ref()
+            .unwrap_or(&self.target_node);
+        let (render_node, effective_target) = if use_primary {
+            (primary, primary)
+        } else {
+            (
+                render_node_for_output(
+                    self.mirroring.as_ref().unwrap_or(&self.output),
+                    &primary,
+                    &self.target_node,
+                    &self.shell.read(),
+                ),
+                self.target_node,
+            )
+        };
 
         // Acquiring a renderer can fail transiently when the underlying DRM
         // device is lost (e.g. after a GPU reset).
-        let mut renderer = if render_node != self.target_node {
+        let mut renderer = if render_node != effective_target {
             self.api
-                .renderer(&render_node, &self.target_node, compositor.format())
